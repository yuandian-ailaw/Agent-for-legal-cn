  "integrations": [
    {
      "capability": "legal_research.search_laws",
      "status": "requires_runtime_connector",
      "fallback": "yuandian-law MCP 不可达时立即停止；不允许用模型知识模拟法条检索。"
    },
    {
      "capability": "legal_research.search_cases",
      "status": "requires_runtime_connector",
