{
  "schema_version": "0.1.0",
  "id": "commercial-legal",
  "title": "商事合同法务 Profile",
  "scope": "practice",
  "practice_area": "commercial-legal",
  "jurisdiction": {
    "primary": "CN",
    "secondary": [],
    "status": "localized"
  },
  "locale": "zh-CN",
  "resolver": {
    "env_var": "LEGAL_AGENT_PROFILE_HOME",
    "default_path": "commercial-legal/profile.md",
    "template_path": "skillpack/profiles/templates/commercial-legal/profile.md",
    "resolution_order": [
      "runtime_provided",
      "environment",
      "workspace",
      "template"
    ]
  },
  "sections": [
    {
      "id": "who-we-are",
      "title": "组织与合同团队",
      "required": true,
      "contains_sensitive_data": true,
      "source": "company",
      "description": "公司、行业、合同量、合同团队和最终升级联系人。"
    },
    {
      "id": "users",
      "title": "使用者与律师联系人",
      "required": true,
      "contains_sensitive_data": true,
      "source": "user",
      "description": "用于决定是否必须添加非法律意见提示和人工复核门槛。"
    },
    {
      "id": "local-storage",
      "title": "本地存储位置",
      "required": true,
      "contains_sensitive_data": true,
      "source": "manual",
      "description": "合同目录、工作成果目录和事项目录。"
    },
    {
      "id": "connectors",
      "title": "连接器状态",
      "required": true,
      "contains_sensitive_data": false,
      "source": "connector",
      "description": "本地存储、元典法规、元典案例等能力的实际可用性。"
    },
    {
      "id": "playbook",
      "title": "合同审查 Playbook",
      "required": true,
      "contains_sensitive_data": true,
      "source": "practice",
      "description": "销售侧和采购侧的标准立场、fallback、never accept 和 one thing。"
    },
    {
      "id": "routing",
      "title": "合同类型路由规则",
      "required": true,
      "contains_sensitive_data": false,
      "source": "practice",
      "description": "NDA、SaaS、供应商协议、DPA、SLA、补充协议等路由。"
    },
    {
      "id": "escalation",
      "title": "升级矩阵",
      "required": true,
      "contains_sensitive_data": true,
      "source": "practice",
      "description": "金额阈值、自动升级事项、审批人和交付方式。"
    },
    {
      "id": "outputs",
      "title": "输出规则",
      "required": true,
      "contains_sensitive_data": false,
      "source": "practice",
      "description": "工作成果头、reviewer note、单一 memo、后续动作树。"
    }
  ],
  "placeholders": [
    {
      "id": "company-name",
      "section_id": "who-we-are",
      "label": "公司名称",
      "question": "被服务的公司或组织名称是什么？",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "contract-volume",
      "section_id": "who-we-are",
      "label": "合同量",
      "question": "每月大约处理多少份合同？主要是销售侧、采购侧还是混合？",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "attorney-contact",
      "section_id": "users",
      "label": "律师联系人",
      "question": "谁负责最终法律判断或升级审批？",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "contracts-path",
      "section_id": "local-storage",
      "label": "合同目录",
      "question": "本地合同库目录在哪里？",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "active-side",
      "section_id": "playbook",
      "label": "主要合同侧",
      "question": "主要是销售侧、采购侧还是两者都有？",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "sales-playbook",
      "section_id": "playbook",
      "label": "销售侧 playbook",
      "question": "销售侧的责任限制、赔偿、数据保护、期限终止和管辖条款标准是什么？",
      "required": false,
      "value_type": "markdown"
    },
    {
      "id": "purchasing-playbook",
      "section_id": "playbook",
      "label": "采购侧 playbook",
      "question": "采购侧的责任限制、赔偿、数据保护、期限终止和管辖条款标准是什么？",
      "required": false,
      "value_type": "markdown"
    },
    {
      "id": "escalation-matrix",
      "section_id": "escalation",
      "label": "升级矩阵",
      "question": "哪些事项必须升级，谁能审批，金额阈值是多少？",
      "required": true,
      "value_type": "markdown"
    }
  ],
  "integrations": [
    {
      "capability": "document_storage.fetch_file",
      "status": "enabled",
      "fallback": "用户上传文件、提供本地路径或粘贴合同全文。"
    },
    {
      "capability": "contract_repository.fetch_agreement",
      "status": "enabled",
      "fallback": "从 LEGAL_AGENT_LOCAL_DATA_HOME/contracts 读取；缺失时要求用户提供合同。"
    },
    {
      "capability": "artifact.write_file",
      "status": "enabled",
      "fallback": "写入失败时在对话中输出完整 memo。"
    },
    {
      "capability": "legal_research.verify_citation",
      "status": "requires_runtime_connector",
      "fallback": "元典 MCP 不可用时保留未验证标记，并提示人工复核。"
    }
  ],
  "guardrails": {
    "substantive_work_requires_completed_profile": true,
    "attorney_contact_required": true,
    "output_header_required": true,
    "privilege_circle_required": true,
    "missing_profile_behavior": "stop_and_request_setup"
  },
  "source": {
    "upstream_repository": "https://github.com/anthropics/claude-for-legal",
    "upstream_path": "commercial-legal/CLAUDE.md",
    "upstream_license": "See upstream repository"
  }
}
