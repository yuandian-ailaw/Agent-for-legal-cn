{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-agent-pack.local/schemas/bundle.schema.json",
  "title": "Legal Agent Skillpack Bundle",
  "description": "可安装的 skill 组合。声明一组 skill、它们依赖的 profile / workflow / capability，以及最低执行要求。给导出生成器、未来的安装器和 MCP gateway legal_skill_list 提供分组语义。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "version",
    "status",
    "skills",
    "required_profiles",
    "minimum_capabilities",
    "offline_capable",
    "minimum_review_level"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "practice_area": {
      "anyOf": [
        {
          "$ref": "#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "deprecated"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "required_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "required_workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "recommended_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityId"
      },
      "uniqueItems": true
    },
    "minimum_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityId"
      },
      "uniqueItems": true
    },
    "offline_capable": {
      "type": "boolean"
    },
    "minimum_review_level": {
      "type": "string",
      "enum": [
        "lawyer",
        "non_lawyer",
        "non_lawyer_with_attorney_access",
        "non_lawyer_without_attorney_access"
      ]
    },
    "entry_skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "setup_skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    }
  }
}
