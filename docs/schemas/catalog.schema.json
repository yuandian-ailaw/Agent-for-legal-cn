{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-agent-pack.local/schemas/catalog.schema.json",
  "title": "Legal Agent Skillpack Catalog",
  "description": "机器可读的 skillpack 索引。给 MCP gateway legal_skill_list、导出生成器、bundle 校验、未来 master router 使用。它索引和约束 skillpack/skills/，但 SKILL.md 才是技能正文的权威源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "summary",
    "practice_areas",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "title",
        "description",
        "license",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "default_locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "supported_locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
          },
          "uniqueItems": true
        },
        "default_jurisdiction": {
          "type": "string"
        },
        "supported_jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "required": [
            "upstream_repository",
            "upstream_license"
          ],
          "properties": {
            "upstream_repository": {
              "type": "string",
              "format": "uri"
            },
            "upstream_license": {
              "type": "string"
            }
          }
        }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_count",
        "practice_areas",
        "kinds"
      ],
      "properties": {
        "skill_count": {
          "type": "integer",
          "minimum": 0
        },
        "practice_areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "kinds": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      }
    },
    "practice_areas": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "profile_id",
            "skill_count"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "profile_id": {
              "$ref": "#/$defs/slug"
            },
            "skill_count": {
              "type": "integer",
              "minimum": 0
            },
            "entry_skill": {
              "anyOf": [
                {
                  "$ref": "#/$defs/slug"
                },
                {
                  "type": "null"
                }
              ]
            },
            "setup_skill": {
              "anyOf": [
                {
                  "$ref": "#/$defs/slug"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogEntry"
      },
      "uniqueItems": true
    },
    "kinds": {
      "type": "object",
      "description": "按 kind 分组的 skill 数量（发布工具生成）",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "path",
        "practice_area",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^skillpack/skills/.+/SKILL\\.md$"
        },
        "practice_area": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "type": "string",
          "enum": [
            "setup",
            "router",
            "triage",
            "review",
            "overlay",
            "handoff",
            "tracker",
            "watcher",
            "analysis",
            "task",
            "customize",
            "generation",
            "response",
            "qa",
            "search",
            "research",
            "lookup"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "converted",
            "validated",
            "deprecated"
          ]
        },
        "user_invocable": {
          "type": "boolean",
          "default": true
        },
        "argument_hint": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "upstream_repository",
            "upstream_path",
            "upstream_license"
          ],
          "properties": {
            "upstream_repository": {
              "type": "string",
              "format": "uri"
            },
            "upstream_path": {
              "type": "string",
              "minLength": 1
            },
            "upstream_license": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "optional_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "depends_on_skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "handoff_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "writes_profile_for_practice": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
