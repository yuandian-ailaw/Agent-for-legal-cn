{
  "schema_version": "0.1.0",
  "id": "skillpack-management",
  "title": "Skillpack 管理 Profile（legal-builder-hub）",
  "scope": "practice",
  "practice_area": "skillpack-management",
  "jurisdiction": {
    "primary": "CN",
    "secondary": [],
    "status": "localized"
  },
  "locale": "zh-CN",
  "resolver": {
    "env_var": "LEGAL_AGENT_PROFILE_HOME",
    "default_path": "skillpack-management/profile.md",
    "template_path": "skillpack/profiles/templates/skillpack-management/profile.md",
    "resolution_order": [
      "runtime_provided",
      "environment",
      "workspace",
      "template"
    ]
  },
  "sections": [
    {
      "id": "company-basics",
      "title": "公司基础信息",
      "required": false,
      "contains_sensitive_data": true,
      "source": "company",
      "description": "跨集群 共享层。"
    },
    {
      "id": "yuanli-config",
      "title": "法律元力 配置",
      "required": true,
      "contains_sensitive_data": false,
      "source": "manual",
      "description": "base_url（默认 https://yuanli.ailaw.cn）+ static fallback toggle + API 可用性标志。"
    },
    {
      "id": "allowlist",
      "title": "Allowlist",
      "required": true,
      "contains_sensitive_data": false,
      "source": "manual",
      "description": "用户级 allowlist（哪些 organization / repo 允许装）— 受保护 cn-localized 8 cluster + hub 自身固定不可移除。"
    },
    {
      "id": "starter-pack",
      "title": "入门包 推荐",
      "required": false,
      "contains_sensitive_data": false,
      "source": "manual",
      "description": "cold-start 推荐安装的 toolkit 列表（默认 cn-localized 7 个）。"
    },
    {
      "id": "install-log",
      "title": "安装日志",
      "required": false,
      "contains_sensitive_data": false,
      "source": "auto",
      "description": "install-log.yaml 记录本机已装 skill 来源与版本。"
    },
    {
      "id": "integrations",
      "title": "集成状态",
      "required": false,
      "contains_sensitive_data": false,
      "source": "connector",
      "description": "法律元力 API 可用性 / GitHub raw 可用性 / 本地存储可用性。"
    }
  ],
  "placeholders": [
    {
      "id": "base-url",
      "section_id": "yuanli-config",
      "label": "法律元力 base_url",
      "question": "法律元力站点地址？（默认 https://yuanli.ailaw.cn；API 不可达时走 yuanli-toolkits.yaml 静态兜底）",
      "required": true,
      "value_type": "string"
    },
    {
      "id": "api-status",
      "section_id": "yuanli-config",
      "label": "API 可用性",
      "question": "法律元力 REST API 是否可用？（`api_available: false` 时 registry-browser / skill-installer / auto-updater 回退 yuanli-toolkits.yaml + GitHub）",
      "required": true,
      "value_type": "boolean"
    },
    {
      "id": "starter-pack-choices",
      "section_id": "starter-pack",
      "label": "入门包 选择",
      "question": "默认推荐 cn-localized 7 个 toolkit。是否调整？",
      "required": false,
      "value_type": "markdown"
    }
  ],
  "integrations": [
    {
      "capability": "artifact.write_file",
      "status": "enabled",
      "fallback": "写入失败时在对话中输出完整内容并提示用户手动保存。"
    },
    {
      "capability": "document_storage.fetch_file",
      "status": "enabled",
      "fallback": "若 install-log.yaml 不可读，要求用户确认或重建。"
    },
    {
      "capability": "web_research.search_secondary_sources",
      "status": "optional_runtime_connector",
      "fallback": "API 不可用时走 yuanli-toolkits.yaml 静态兜底 + GitHub 社区 registry。"
    }
  ],
  "guardrails": {
    "substantive_work_requires_completed_profile": true,
    "attorney_contact_required": false,
    "output_header_required": false,
    "privilege_circle_required": false,
    "missing_profile_behavior": "stop_and_request_setup"
  }
}
